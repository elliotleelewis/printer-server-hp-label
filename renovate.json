{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "repositories": ["elliotleelewis/printer-server-hp-label"],
  "extends": ["config:recommended", ":preserveSemverRanges", ":semanticCommits"],
  "packageRules": [
    {
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "The filter runs on the Pi's system Python (3.11 on Debian 12), so CI stays on it.",
      "matchPackageNames": ["python"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
